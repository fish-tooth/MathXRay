# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtualenv ---
.venv/
venv/
env/

# --- Secrets (API keys MUST come from environment) ---
.env
.env.*
!.env.example

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# --- IDE ---
.idea/
.vscode/
*.swp

# --- Project data (raw may be non-redistributable) ---
data/raw/
data/high_school*.json
data/processed/highschool*

# --- Generated results (keep .gitkeep dirs, ignore generated files in git) ---
# Do NOT delete local files under results/raw or results/summaries.
# They are required to recompute reports/official/.
results/raw/*
!results/raw/.gitkeep
results/parsed/*
!results/parsed/.gitkeep
results/summaries/*
!results/summaries/.gitkeep

# --- Demo capture intermediates (keep demo/mathxray.gif) ---
demo/frames/

# --- Internal assistant memory ---
.workbuddy/
.codebuddy/
